APP_NAME="AI Customer Loan Assistance Chatbot"
ENVIRONMENT="development"
API_HOST="127.0.0.1"
API_PORT=8000
FRONTEND_API_URL="http://127.0.0.1:8000"

DATABASE_URL="sqlite:///./database/chatbot.db"
UPLOAD_DIR="./uploads"
VECTORSTORE_DIR="./vectorstore/chroma"
SAMPLE_DATA_DIR="./sample_data"

OPENROUTER_API_KEY="replace-with-your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_SITE_URL="http://localhost"
OPENROUTER_APP_NAME="Loan Assistance Chatbot"

JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
